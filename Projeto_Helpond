<script>
// ── FONT SIZE ──
let fontSize = 18;
const minFont = 12, maxFont = 28;
function setFont(size) {
  fontSize = Math.min(maxFont, Math.max(minFont, size));
  document.documentElement.style.setProperty('--font-size-base', fontSize + 'px');
}
document.getElementById('btn-font-inc').addEventListener('click', () => setFont(fontSize + 2));
document.getElementById('btn-font-dec').addEventListener('click', () => setFont(fontSize - 2));

// ── DARK MODE ──
let dark = false;
document.getElementById('btn-dark').addEventListener('click', function() {
  dark = !dark;
  document.body.setAttribute('data-theme', dark ? 'dark' : '');
  this.classList.toggle('active', dark);
  this.setAttribute('aria-pressed', dark);
});

// ── HIGH CONTRAST ──
let contrast = false;
document.getElementById('btn-contrast').addEventListener('click', function() {
  contrast = !contrast;
  document.body.setAttribute('data-contrast', contrast ? 'high' : '');
  this.classList.toggle('active', contrast);
  this.setAttribute('aria-pressed', contrast);
});

// ── RESET ──
document.getElementById('btn-reset').addEventListener('click', function() {
  setFont(18);
  dark = false; contrast = false;
  document.body.removeAttribute('data-theme');
  document.body.removeAttribute('data-contrast');
  document.querySelectorAll('.a11y-btn').forEach(b => b.classList.remove('active'));
  window.speechSynthesis && window.speechSynthesis.cancel();
  ttsActive = false;
  document.getElementById('tts-status').style.display = 'none';
  document.getElementById('btn-tts').classList.remove('active');
});

// ── TTS ──
let ttsActive = false;
function speak(text) {
  if (!window.speechSynthesis) { alert('Seu navegador não suporta síntese de voz.'); return; }
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = 'pt-BR';
  utter.rate = 0.9;
  const status = document.getElementById('tts-status');
  status.style.display = 'inline';
  utter.onend = () => { status.style.display = 'none'; };
  utter.onerror = () => { status.style.display = 'none'; };
  window.speechSynthesis.speak(utter);
}

document.getElementById('btn-tts').addEventListener('click', function() {
  ttsActive = !ttsActive;
  this.classList.toggle('active', ttsActive);
  this.setAttribute('aria-pressed', ttsActive);
  if (ttsActive) {
    speak('Leitura de tela ativada. Clique em qualquer parágrafo para ouvi-lo.');
  } else {
    window.speechSynthesis && window.speechSynthesis.cancel();
    document.getElementById('tts-status').style.display = 'none';
  }
});

document.addEventListener('click', function(e) {
  if (!ttsActive) return;
  const el = e.target.closest('p, h1, h2, h3, li, td, th, article');
  if (el && !el.closest('#a11y-bar') && !el.closest('button')) {
    speak(el.innerText);
  }
});

// ── DEMO TTS ──
function speakDemo() {
  const t = document.getElementById('preview-title').innerText + '. ' +
            document.getElementById('preview-body').innerText + ' ' +
            document.getElementById('preview-body2').innerText;
  speak(t);
}
document.getElementById('demo-tts-btn').addEventListener('click', speakDemo);
document.getElementById('demo-tts-area').addEventListener('click', speakDemo);
document.getElementById('demo-tts-area').addEventListener('keydown', e => { if(e.key==='Enter'||e.key===' ') speakDemo(); });

// ── DEMO SLIDERS ──
const fontSlider = document.getElementById('demo-font-slider');
const fontVal = document.getElementById('demo-font-val');
const lineSlider = document.getElementById('demo-line-slider');
const lineVal = document.getElementById('demo-line-val');
const preview = document.getElementById('preview-content');

fontSlider.addEventListener('input', function() {
  const v = this.value;
  preview.style.fontSize = v + 'px';
  fontVal.textContent = v + 'px';
  this.setAttribute('aria-valuenow', v);
});
lineSlider.addEventListener('input', function() {
  const v = parseFloat(this.value).toFixed(1);
  preview.style.lineHeight = v;
  lineVal.textContent = v;
  this.setAttribute('aria-valuenow', v);
});

// ── ANIMATE PROGRESS BARS ON SCROLL ──
const bars = document.querySelectorAll('.progress-fill');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.style.width = e.target.style.width; });
}, { threshold: 0.2 });
bars.forEach(b => observer.observe(b));
</script>
